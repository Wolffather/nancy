# API-ключ для DeepSeek
DEEPSEEK_API_KEY=sk-...

# Настройки трекинг-системы (опционально)
TS_URL=https://...
TS_EMAIL=...
TS_API_TOKEN=...

# Пути к скиллам и шаблонам
SKILLS_DIR=skills
TEMPLATE_DIR=resources

# Дефолтные значения для генерации (если не указаны в командной строке)
NANCY_DEFAULT_LANGUAGE=java
NANCY_DEFAULT_FRAMEWORK=junit5+restassured
NANCY_DEFAULT_SKILL=api
# Дефолтный фреймворк (если не указан, используется junit5+restassured)
NANCY_DEFAULT_FRAMEWORK=junit5+restassured