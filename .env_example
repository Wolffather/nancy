# Единый API-ключ для LLM (DeepSeek, Qwen, Claude через OpenAI-совместимый API)
LLM_API_KEY=sk-...

# Настройки LLM
LLM_MODEL=deepseek-chat                # или qwen-plus, claude-3-sonnet и т.д.
LLM_BASE_URL=https://api.deepseek.com/v1   # для Qwen: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.3

# Трекер-система (опционально, можно оставить пустым)
TS_URL=
TS_EMAIL=
TS_API_TOKEN=
TS_API_PATH=/rest/api/3
MOCK_TS=false

# Пути к директориям
SKILLS_DIR=skills
PROMPTS_DIR=nancy/prompts
TEMPLATES_DIR=nancy/web/templates

# Дефолтные настройки генерации (если не указаны в командной строке)
NANCY_DEFAULT_LANGUAGE=java
NANCY_DEFAULT_SKILL=api
NANCY_DEFAULT_FRAMEWORK=junit5+restassured